import random

# Dictionary containing probabilities
model = {
    "book": [("NN", 0.7), ("VB", 0.3)],
    "play": [("VB", 0.6), ("NN", 0.4)],
    "run": [("VB", 0.8), ("NN", 0.2)],
    "cat": [("NN", 1.0)],
    "dog": [("NN", 1.0)]
}

sentence = input("Enter words: ").split()

print("\nPredicted POS Tags")

for word in sentence:
    if word in model:
        tags = model[word]
        pos = random.choices(
            [t[0] for t in tags],
            weights=[t[1] for t in tags]
        )[0]
        print(word, ":", pos)
    else:
        print(word, ": Unknown")
