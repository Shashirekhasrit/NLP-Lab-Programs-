import nltk
from nltk import CFG
from nltk.parse import EarleyChartParse
grammar = CFG.fromstring("""
S -> NP VP
NP -> Det N | 'John' | 'Mary'
VP -> V NP | V
Det -> 'the' | 'a'
N -> 'cat' | 'dog'
V -> 'sees' | 'runs'
""
parser = EarleyChartParser(grammar)
sentence = input("Enter a sentence: ").split()

print("\nParse Trees:")

try:
    found = False
    for tree in parser.parse(sentence):
        print(tree)
        found = True

    if not found:
        print("Sentence cannot be parsed.")

except ValueError:
    print("Invalid words in the grammar.")
